{
  "format_version": 2,
  "variant": "cnn_ensemble3",
  "architecture": {
    "type": "ensemble",
    "members": 3,
    "array_prefix": "m{i}_",
    "member": {
      "type": "cnn",
      "embed_dim": 64,
      "kernels": [
        2,
        3,
        4,
        5
      ],
      "filters": 160,
      "hidden": 192,
      "layer_list": [
        {
          "op": "embedding",
          "arrays": [
            "m{i}_embedding"
          ]
        },
        {
          "op": "conv1d_valid",
          "kernel": 2,
          "then": "relu → 全局最大池化（时间维）",
          "arrays": [
            "m{i}_conv2_weight",
            "m{i}_conv2_bias"
          ]
        },
        {
          "op": "conv1d_valid",
          "kernel": 3,
          "then": "relu → 全局最大池化（时间维）",
          "arrays": [
            "m{i}_conv3_weight",
            "m{i}_conv3_bias"
          ]
        },
        {
          "op": "conv1d_valid",
          "kernel": 4,
          "then": "relu → 全局最大池化（时间维）",
          "arrays": [
            "m{i}_conv4_weight",
            "m{i}_conv4_bias"
          ]
        },
        {
          "op": "conv1d_valid",
          "kernel": 5,
          "then": "relu → 全局最大池化（时间维）",
          "arrays": [
            "m{i}_conv5_weight",
            "m{i}_conv5_bias"
          ]
        },
        {
          "op": "concat",
          "order": "kernels 顺序"
        },
        {
          "op": "linear",
          "then": "relu",
          "arrays": [
            "m{i}_dense_weight",
            "m{i}_dense_bias"
          ]
        },
        {
          "op": "linear",
          "then": "按 heads 切片",
          "arrays": [
            "m{i}_heads_weight",
            "m{i}_heads_bias"
          ]
        }
      ],
      "forward": "embedding → 每个 k：conv{k}（valid 卷积）→ ReLU → 全局最大池化；按 kernels 顺序拼接 → dense → ReLU → heads"
    },
    "combine": {
      "class": "log(mean_i softmax(z_i))（之后照常 softmax(z / temperature)）",
      "tanh": "atanh(clip(mean_i tanh(z_i), -1 + 1e-06, 1 - 1e-06))",
      "sigmoid": "logit(clip(mean_i sigmoid(z_i), 1e-06, 1 - 1e-06))（bce 头同）"
    },
    "forward": "每个成员按 member 的 CNN 前向得到原始输出 z_i（数组名前缀 m0_、m1_ …），再按 combine 逐头合并成一个原始输出",
    "conventions": {
      "linear": "y = x @ weight.T + bias（weight 为 PyTorch 的 (输出, 输入)）",
      "conv1d": "weight (输出通道, 输入通道, k)；滑动窗口 (位置, 输入通道, k) 展平后乘 weight.reshape(输出通道, -1).T",
      "dtype": "数组存为 float16，加载后转 float32 计算"
    }
  },
  "variant_fingerprint": "4524170efaf8d8b0",
  "teacher_fingerprint": "fafdf74df467f17a",
  "targets_fingerprint": "3ae9af0cd950782d",
  "preprocess": "html.unescape → NBSP 换为空格 → 连续空白合并为一个空格 → 去掉首尾空白；按字（Unicode 码位）切分，不在字表中的字记为 UNK",
  "max_len": 160,
  "head_chars": 48,
  "min_len": 5,
  "truncation": "超过 max_len 时保留开头 head_chars 个字和结尾 max_len - head_chars 个字；不足 min_len 时右侧补 PAD",
  "heads": [
